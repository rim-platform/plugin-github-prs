{
  "name": "rim-plugin-github-prs",
  "version": "0.0.1",
  "private": true,
  "description": "RIM plugin that lists the open pull requests of public GitHub repositories",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rim-platform/plugin-github-prs",
  "bugs": {
    "url": "https://github.com/rim-platform/plugin-github-prs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rim-platform/plugin-github-prs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rim-plugin-bundle --in-place --entry src/main.ts .",
    "check": "rim-plugin-bundle --check --entry src/main.ts .",
    "bundle": "rim-plugin-bundle --entry src/main.ts .",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rim-platform/plugin-sdk": "0.2.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
